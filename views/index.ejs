      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section-padding" id="contact">
    <div class="container">
      <div class="text-center mx-auto mb-5">
        <div class="section-tag">
          <i class="bi bi-chat-right-text"></i> Start a Conversation
        </div>
        <h2 class="section-title">Get In Touch</h2>
        <p class="section-subtitle mx-auto">
          Book a free 30-minute discovery call to evaluate your current exposure, review your security requirements, and discuss customized consulting options.
        </p>
      </div>

      <div class="row g-4 align-items-stretch">
        <!-- Contact Information Block -->
        <div class="col-lg-5">
          <div class="contact-info-card">
            <h3 class="h4 mb-4">Direct Contact Information</h3>

            <!-- Email -->
            <div class="contact-item">
              <div class="contact-icon-wrapper">
                <i class="bi bi-envelope-fill"></i>
              </div>
              <div>
                <div class="contact-label">Email Address</div>
                <a href="mailto:<%= email || 'usman@usmancybersecurity.com' %>" class="contact-val">
                  <%= email || 'usman@usmancybersecurity.com' %>
                </a>
              </div>
            </div>

            <!-- Phone -->
            <div class="contact-item">
              <div class="contact-icon-wrapper">
                <i class="bi bi-telephone-fill"></i>
              </div>
              <div>
                <div class="contact-label">Phone &amp; WhatsApp</div>
                <a href="tel:<%= (phone || '+971 4 234 5678').replace(/\s+/g, '') %>" class="contact-val">
                  <%= phone || '+971 4 234 5678' %>
                </a>
              </div>
            </div>

            <!-- Location -->
            <div class="contact-item">
              <div class="contact-icon-wrapper">
                <i class="bi bi-geo-alt-fill"></i>
              </div>
              <div>
                <div class="contact-label">Location</div>
                <div class="contact-val">
                  <%= location || 'Dubai, UAE · Remote Worldwide' %>
                </div>
              </div>
            </div>

            <!-- Availability -->
            <div class="contact-item">
              <div class="contact-icon-wrapper">
                <i class="bi bi-clock-fill"></i>
              </div>
              <div>
                <div class="contact-label">Availability &amp; Hours</div>
                <div class="contact-val">
                  <%= availability || 'Mon–Fri 9am–6pm GST' %>
                </div>
              </div>
            </div>

            <div class="mt-4 pt-3 border-top border-secondary-subtle">
              <div class="d-flex align-items-center gap-2 text-teal small font-mono">
                <i class="bi bi-shield-lock"></i> PGP Encrypted Comms Available Upon Request
              </div>
            </div>
          </div>
        </div>

        <!-- Discovery Call & Contact Form Block -->
        <div class="col-lg-7">
          <div class="contact-form-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h3 class="h4 mb-0">Send a Confidential Message</h3>
              <a href="/booking" class="btn btn-sm btn-outline-teal d-none d-sm-inline-flex align-items-center">
                <i class="bi bi-calendar-event me-1"></i> Pick a Time Slot
              </a>
            </div>
            <p class="text-muted small mb-3">
              Submit your inquiry below or schedule directly via the calendar wizard. All information shared is handled under non-disclosure terms.
            </p>

            <div class="p-3 mb-3 rounded-3 bg-navy-subtle border border-secondary d-flex align-items-center justify-content-between flex-wrap gap-2">
              <div class="small text-muted">
                <i class="bi bi-calendar-check text-teal me-1"></i> Prefer a live discovery call? Select a 30-min weekday slot.
              </div>
              <a href="/booking" class="btn btn-teal-glow btn-sm py-1 px-3">
                Open Booking Calendar &rarr;
              </a>
            </div>

            <form id="discoveryForm" action="/contact" method="POST" onsubmit="handleContactSubmit(event)">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <!-- Anti-bot Honeypot Field -->
              <div class="hp-trap" style="display: none !important; visibility: hidden !important;" aria-hidden="true">
                <label for="hp_idx_website">Leave this field blank</label>
                <input type="text" name="website" id="hp_idx_website" tabindex="-1" autocomplete="off">
              </div>

              <div class="row g-3">
                <div class="col-md-6">
                  <label for="clientName" class="form-label">Full Name *</label>
                  <input type="text" class="form-control" id="clientName" name="name" placeholder="e.g. Alex Morgan" maxlength="100" required>
                </div>
                <div class="col-md-6">
                  <label for="clientEmail" class="form-label">Work Email *</label>
                  <input type="email" class="form-control" id="clientEmail" name="email" placeholder="e.g. alex@company.com" maxlength="100" required>
                </div>
                <div class="col-12">
                  <label for="clientCompany" class="form-label">Company / Organization <span class="text-muted">(Optional)</span></label>
                  <input type="text" class="form-control" id="clientCompany" name="company" placeholder="e.g. Acme FinTech" maxlength="100">
                </div>
                <div class="col-12">
                  <label for="clientMessage" class="form-label">Project Scope &amp; Objectives *</label>
                  <textarea class="form-control" id="clientMessage" name="message" rows="4" maxlength="1000" placeholder="Briefly describe your systems, upcoming security audits, or specific concerns..." required></textarea>
                </div>
                <div class="col-12 pt-2">
                  <button type="submit" class="btn btn-teal-glow w-100 py-3" id="submitInquiryBtn">
                    <i class="bi bi-send-fill me-2"></i> Send Confidential Inquiry
                  </button>
                </div>
              </div>
            </form>

            <div id="formSuccessAlert" class="alert alert-success mt-3 d-none align-items-center" role="alert">
              <i class="bi bi-check-circle-fill me-2 fs-5"></i>
              <div id="successAlertMsg">
                <strong>Thank you!</strong> Your message has been received. Usman will reach out within 24 business hours.
              </div>
            </div>

            <div id="formErrorAlert" class="alert alert-danger mt-3 d-none align-items-start gap-2" role="alert">
              <i class="bi bi-exclamation-triangle-fill fs-5 mt-1 flex-shrink-0"></i>
              <div id="errorAlertMsg"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<script>
  async function handleContactSubmit(event) {
    event.preventDefault();
    const btn = document.getElementById('submitInquiryBtn');
    const successBox = document.getElementById('formSuccessAlert');
    const errorBox = document.getElementById('formErrorAlert');
    const errorMsg = document.getElementById('errorAlertMsg');
    const successMsg = document.getElementById('successAlertMsg');

    successBox.classList.add('d-none');
    errorBox.classList.add('d-none');

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Sending...';

    const payload = {
      name: document.getElementById('clientName').value,
      email: document.getElementById('clientEmail').value,
      company: document.getElementById('clientCompany').value,
      message: document.getElementById('clientMessage').value,
      website: document.getElementById('hp_idx_website').value
    };

    try {
      const res = await fetch('/contact', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(payload)
      });

      const data = await res.json();

      if (res.ok && data.success) {
        btn.innerHTML = '<i class="bi bi-check2 me-2"></i> Inquiry Sent Successfully';
        btn.classList.remove('btn-teal-glow');
        btn.classList.add('btn-success');
        successMsg.innerHTML = `<strong>Thank you!</strong> ${data.message || 'Your inquiry has been registered.'}`;
        successBox.classList.remove('d-none');
        document.getElementById('discoveryForm').reset();
      } else {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-send-fill me-2"></i> Send Confidential Inquiry';
        const errList = data.errors ? data.errors.join('<br>') : 'An unexpected error occurred. Please try again.';
        errorMsg.innerHTML = `<strong>Error:</strong><br>${errList}`;
        errorBox.classList.remove('d-none');
      }
    } catch (err) {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-send-fill me-2"></i> Send Confidential Inquiry';
      errorMsg.innerHTML = '<strong>Network error:</strong> Unable to reach server. Please try again or email us directly.';
      errorBox.classList.remove('d-none');
    }
  }
</script>

<%- include('partials/footer') %>
