<%- include('partials/header') %>

<main class="py-5 my-auto">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-7 col-lg-6">
        <div class="booking-card p-4 p-md-5 text-center">
          <div class="mb-4">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle border border-danger text-danger p-3" style="width: 72px; height: 72px;">
              <i class="bi bi-shield-exclamation fs-1"></i>
            </span>
          </div>

          <div class="badge bg-danger-subtle text-danger border border-danger font-mono mb-3 px-3 py-1">
            HTTP <%= typeof statusCode !== 'undefined' ? statusCode : 500 %>
          </div>

          <h1 class="h3 mb-3 text-white">Security &amp; Application Notice</h1>
          
          <p class="text-muted mb-4">
            <%= typeof message !== 'undefined' ? message : 'An unexpected condition was encountered. For security and privacy, details have been logged internally.' %>
          </p>

          <div class="d-flex flex-wrap justify-content-center gap-2">
            <a href="/" class="btn btn-outline-teal px-4 py-2">
              <i class="bi bi-house-door me-1"></i> Return Home
            </a>
            <a href="/booking" class="btn btn-teal px-4 py-2 text-dark fw-bold">
              <i class="bi bi-calendar-check me-1"></i> Book Discovery Call
            </a>
          </div>

          <div class="mt-4 pt-3 border-top border-secondary-subtle">
            <small class="text-dim font-mono">
              <%= typeof brandName !== 'undefined' ? brandName : 'Usman Naeem Cyber Security Consulting' %> &middot; Secure Operations
            </small>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
