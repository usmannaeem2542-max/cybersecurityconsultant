<%- include('partials/header') %>

<main class="py-5">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">

        <div class="booking-card p-4 p-md-5">
          <div class="text-center mb-4">
            <div class="brand-icon-box mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.6rem;">
              <i class="bi bi-shield-lock-fill"></i>
            </div>
            <div class="section-tag mb-2">
              <i class="bi bi-key-fill"></i> Internal Portal
            </div>
            <h1 class="h3 mb-1">Consultant Login</h1>
            <p class="text-muted small">
              Restricted administrative access for Usman Naeem.
            </p>
          </div>

          <% if (error) { %>
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
              <i class="bi bi-shield-exclamation fs-5 flex-shrink-0"></i>
              <div><%= error %></div>
            </div>
          <% } %>

          <form action="/login" method="POST" autocomplete="off">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <div class="mb-3">
              <label for="adminEmail" class="form-label text-light fw-semibold">Admin Email</label>
              <div class="input-group">
                <span class="input-group-text bg-navy-subtle border-secondary text-teal">
                  <i class="bi bi-envelope-at"></i>
                </span>
                <input 
                  type="email" 
                  id="adminEmail" 
                  name="email" 
                  class="form-control" 
                  placeholder="admin@usmancybersecurity.com" 
                  value="<%= emailValue || '' %>" 
                  required 
                  autofocus
                >
              </div>
            </div>

            <div class="mb-4">
              <label for="adminPassword" class="form-label text-light fw-semibold">Password</label>
              <div class="input-group">
                <span class="input-group-text bg-navy-subtle border-secondary text-teal">
                  <i class="bi bi-lock-fill"></i>
                </span>
                <input 
                  type="password" 
                  id="adminPassword" 
                  name="password" 
                  class="form-control" 
                  placeholder="••••••••••••" 
                  required
                >
              </div>
            </div>

            <button type="submit" class="btn btn-teal-glow w-100 py-3 mb-3" id="adminLoginBtn">
              <i class="bi bi-box-arrow-in-right me-2"></i> Authenticate &amp; Access Dashboard
            </button>
          </form>

          <div class="text-center border-top border-secondary-subtle pt-3 mt-2">
            <p class="text-muted small mb-0 font-mono">
              <i class="bi bi-info-circle me-1 text-teal"></i> No public registration permitted.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
