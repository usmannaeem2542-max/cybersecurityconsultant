<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stripe Checkout &middot; Usman Naeem Cyber Security Consulting</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --stripe-bg: #0a2540;
      --stripe-surface: #102a45;
      --stripe-card: #153250;
      --stripe-border: rgba(255, 255, 255, 0.12);
      --stripe-primary: #635bff;
      --stripe-primary-hover: #7a73ff;
      --stripe-accent: #00d4aa;
      --stripe-text: #ffffff;
      --stripe-muted: #adbdcc;
    }

    * {
      box-sizing: border-box;
    }

    body {
      background: #091728;
      color: var(--stripe-text);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      margin: 0;
    }

    .test-mode-banner {
      background: #ffb627;
      color: #000;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-align: center;
      padding: 0.4rem 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }

    .checkout-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2.5rem 1rem;
    }

    .stripe-card-box {
      width: 100%;
      max-width: 960px;
      background: var(--stripe-surface);
      border: 1px solid var(--stripe-border);
      border-radius: 16px;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5), 0 0 30px rgba(99, 91, 255, 0.1);
      overflow: hidden;
    }

    .order-sidebar {
      background: #0d2138;
      border-right: 1px solid var(--stripe-border);
      padding: 2.5rem;
    }

    .payment-panel {
      padding: 2.5rem;
    }

    .brand-avatar {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: linear-gradient(135deg, #00f5d4 0%, #00b4d8 100%);
      color: #050d1a;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: bold;
    }

    .deposit-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.25rem 0.65rem;
      background: rgba(0, 212, 170, 0.15);
      border: 1px solid rgba(0, 212, 170, 0.4);
      color: #00f5d4;
      border-radius: 6px;
      font-size: 0.75rem;
      font-family: 'JetBrains Mono', monospace;
    }

    .form-control, .form-select {
      background: #0d2138 !important;
      border: 1px solid rgba(255, 255, 255, 0.18) !important;
      color: #fff !important;
      border-radius: 8px;
      padding: 0.75rem 1rem;
      font-size: 0.95rem;
    }

    .form-control:focus {
      border-color: var(--stripe-primary) !important;
      box-shadow: 0 0 0 3px rgba(99, 91, 255, 0.3) !important;
    }

    .form-label {
      color: var(--stripe-muted);
      font-size: 0.85rem;
      font-weight: 500;
      margin-bottom: 0.35rem;
    }

    .btn-stripe-pay {
      background: var(--stripe-primary);
      color: #fff;
      font-weight: 600;
      font-size: 1.05rem;
      border: none;
      border-radius: 8px;
      padding: 0.9rem;
      width: 100%;
      box-shadow: 0 4px 14px rgba(99, 91, 255, 0.4);
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .btn-stripe-pay:hover {
      background: var(--stripe-primary-hover);
      box-shadow: 0 6px 20px rgba(99, 91, 255, 0.6);
      transform: translateY(-1px);
    }

    .test-pill-btn {
      background: rgba(99, 91, 255, 0.15);
      border: 1px dashed #635bff;
      color: #a29bfe;
      font-size: 0.78rem;
      border-radius: 6px;
      padding: 0.35rem 0.7rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .test-pill-btn:hover {
      background: rgba(99, 91, 255, 0.3);
      color: #fff;
    }

    .stripe-footer {
      text-align: center;
      padding: 1.5rem;
      font-size: 0.8rem;
      color: var(--stripe-muted);
    }

    .stripe-footer a {
      color: var(--stripe-muted);
      text-decoration: none;
    }

    .stripe-footer a:hover {
      color: #fff;
      text-decoration: underline;
    }

    @media (max-width: 991px) {
      .order-sidebar {
        border-right: none;
        border-bottom: 1px solid var(--stripe-border);
      }
    }
  </style>
</head>
<body>

  <!-- Top Test Mode Stripe Banner -->
  <div class="test-mode-banner">
    <i class="bi bi-shield-fill-exclamation"></i>
    <span>Stripe Checkout &mdash; Test Mode Active</span>
  </div>

  <div class="checkout-wrapper">
    <div class="stripe-card-box">
      <div class="row g-0">

        <!-- Left Column: Order Summary -->
        <div class="col-lg-5 order-sidebar d-flex flex-column justify-content-between">
          <div>
            <a href="/booking" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-4">
              <i class="bi bi-arrow-left"></i> Return to <%= brandName %>
            </a>

            <div class="d-flex align-items-center gap-3 mb-4">
              <div class="brand-avatar">
                <i class="bi bi-shield-lock-fill"></i>
              </div>
              <div>
                <h5 class="mb-0 fw-bold"><%= consultantName %></h5>
                <span class="text-muted small">Independent Cyber Security</span>
              </div>
            </div>

            <div class="mb-4">
              <span class="text-muted small text-uppercase" style="letter-spacing: 0.05em;">Deposit Required</span>
              <div class="display-6 fw-bold mt-1 text-white">
                AED 200.00
              </div>
            </div>

            <div class="p-3 rounded-3 mb-4" style="background: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.08);">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <div class="fw-semibold text-white"><%= booking.service %></div>
                  <div class="small text-muted">Consultation Deposit</div>
                </div>
                <div class="font-mono fw-bold text-white">AED 200.00</div>
              </div>
              <hr style="border-color: rgba(255, 255, 255, 0.1); margin: 0.75rem 0;">
              <div class="small text-muted d-flex align-items-center justify-content-between">
                <span>Date &amp; Time (GST):</span>
                <span class="text-white font-mono"><%= booking.bookingDateTime %></span>
              </div>
              <div class="small text-muted d-flex align-items-center justify-content-between mt-1">
                <span>Client:</span>
                <span class="text-white"><%= booking.clientName %></span>
              </div>
              <div class="small text-muted d-flex align-items-center justify-content-between mt-1">
                <span>Email:</span>
                <span class="text-white"><%= booking.clientEmail %></span>
              </div>
            </div>

            <div class="deposit-badge mb-3">
              <i class="bi bi-lock-fill"></i> Fully Credited Against Engagement Fee
            </div>
          </div>

          <div class="small text-muted pt-3">
            <i class="bi bi-shield-check text-success me-1"></i> End-to-end 256-bit encrypted checkout.
          </div>
        </div>

        <!-- Right Column: Stripe Payment Form -->
        <div class="col-lg-7 payment-panel">
          <div class="d-flex align-items-center justify-content-between mb-4">
            <h4 class="mb-0 fw-bold">Pay with card</h4>
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-credit-card-2-front text-muted fs-4"></i>
              <span class="badge bg-secondary-subtle text-light border border-secondary font-mono" style="font-size: 0.7rem;">TEST</span>
            </div>
          </div>

          <!-- Quick auto-fill button for testing -->
          <div class="mb-4 p-3 rounded-3 d-flex align-items-center justify-content-between flex-wrap gap-2" style="background: rgba(99, 91, 255, 0.1); border: 1px solid rgba(99, 91, 255, 0.3);">
            <div class="small">
              <strong class="text-white">Stripe Test Credentials:</strong>
              <div class="text-muted" style="font-size: 0.78rem;">Use standard <code>4242 &bull;&bull;&bull;&bull; 4242</code> card</div>
            </div>
            <button type="button" class="test-pill-btn" id="autofillCardBtn">
              <i class="bi bi-magic me-1"></i> Fill Test Card
            </button>
          </div>

          <form action="/stripe-checkout/confirm" method="POST" id="stripeCheckoutForm">
            <input type="hidden" name="session_id" value="<%= sessionId %>">

            <div class="mb-3">
              <label class="form-label" for="cardEmail">Email</label>
              <input type="email" class="form-control" id="cardEmail" name="email" value="<%= booking.clientEmail %>" required>
            </div>

            <div class="mb-3">
              <label class="form-label" for="cardNumber">Card information</label>
              <div class="position-relative">
                <input type="text" class="form-control font-mono" id="cardNumber" name="cardNumber" placeholder="4242 4242 4242 4242" value="4242 4242 4242 4242" maxlength="19" required>
                <div class="position-absolute end-0 top-50 translate-middle-y pe-3 text-muted">
                  <i class="bi bi-credit-card-fill fs-5" id="cardBrandIcon"></i>
                </div>
              </div>
              <div class="row g-2 mt-1">
                <div class="col-6">
                  <input type="text" class="form-control font-mono" id="cardExp" name="cardExp" placeholder="MM / YY" value="12 / 28" maxlength="7" required>
                </div>
                <div class="col-6">
                  <div class="position-relative">
                    <input type="password" class="form-control font-mono" id="cardCvc" name="cardCvc" placeholder="CVC" value="123" maxlength="4" required>
                    <i class="bi bi-question-circle position-absolute end-0 top-50 translate-middle-y pe-3 text-muted small" title="3 digits on back"></i>
                  </div>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label" for="cardName">Cardholder name</label>
              <input type="text" class="form-control" id="cardName" name="cardName" value="<%= booking.clientName %>" required>
            </div>

            <div class="mb-4">
              <label class="form-label" for="cardCountry">Country or region</label>
              <select class="form-select" id="cardCountry" name="country">
                <option value="AE" selected>United Arab Emirates</option>
                <option value="US">United States</option>
                <option value="GB">United Kingdom</option>
                <option value="SA">Saudi Arabia</option>
                <option value="QA">Qatar</option>
                <option value="OTHER">Other Country</option>
              </select>
            </div>

            <button type="submit" class="btn-stripe-pay d-flex align-items-center justify-content-center gap-2" id="submitPayBtn">
              <i class="bi bi-lock-fill"></i>
              <span id="btnText">Pay AED 200.00</span>
            </button>

            <div class="text-center mt-3">
              <a href="/booking" class="text-muted small text-decoration-none">
                Cancel and return to booking
              </a>
            </div>
          </form>

        </div>
      </div>
    </div>
  </div>

  <footer class="stripe-footer">
    <div class="d-flex align-items-center justify-content-center gap-3">
      <span>Powered by <strong class="text-light">stripe</strong></span>
      <span>&middot;</span>
      <a href="#">Terms</a>
      <span>&middot;</span>
      <a href="#">Privacy</a>
    </div>
  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('stripeCheckoutForm');
      const submitBtn = document.getElementById('submitPayBtn');
      const btnText = document.getElementById('btnText');
      const autofillBtn = document.getElementById('autofillCardBtn');
      const cardNum = document.getElementById('cardNumber');
      const cardExp = document.getElementById('cardExp');
      const cardCvc = document.getElementById('cardCvc');

      if (autofillBtn) {
        autofillBtn.addEventListener('click', () => {
          cardNum.value = '4242 4242 4242 4242';
          cardExp.value = '12 / 28';
          cardCvc.value = '123';
          cardNum.focus();
        });
      }

      form.addEventListener('submit', () => {
        submitBtn.disabled = true;
        btnText.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Processing payment...';
      });
    });
  </script>

</body>
</html>
